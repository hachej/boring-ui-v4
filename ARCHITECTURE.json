    "BORING-PI-2": "test/contracts/pi-harness-attachment.test.mjs",
    "BORING-PI-3": "test/contracts/pi-optional-extensions.test.mjs",
    "BORING-PI-4": "test/contracts/pi-public-adapters.test.mjs",
