  "reservedKinds": "pi.",
  "blockedKernelClasses": [
    "BoringHarness",
    "BoringScheduler",
    "BoringAgentLoop",
    "BoringReplayEngine"
  ],
  "sourceDistribution": {
    "manifest": "registry.json",
    "format": "shadcn@4.21.0",
