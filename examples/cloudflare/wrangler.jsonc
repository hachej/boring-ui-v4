{
  "name": "boring-ui-v4-recipe",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "ai": { "binding": "AI" },
  // `/` runs the Worker first: it is the signup landing page when signup is configured (src/signup.mjs).
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/", "/index.html"] },
  "durable_objects": { "bindings": [{ "name": "ASSISTANT", "class_name": "Assistant" }, { "name": "REGISTRY", "class_name": "Registry" }] },
  // v2 adds the signup registry (one object: codes and which WhatsApp number routes to which person's agent).
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Assistant"] }, { "tag": "v2", "new_sqlite_classes": ["Registry"] }],
  "observability": { "enabled": true }
}
